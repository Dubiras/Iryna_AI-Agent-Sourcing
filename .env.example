# ═══════════════════════════════════════════════════
# LumysAgent Orchestrator — Environment Variables
# cp .env.example .env  і заповни
# ═══════════════════════════════════════════════════

# ── Обов'язкові ─────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# Telegram (один токен для оркестратора)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DIGEST_CHAT_ID=

# Claude OAuth токени (claude.ai → Settings → API)
CLAUDE_CODE_OAUTH_TOKEN=
# Додаткові токени для ротації при rate limit:
# CLAUDE_TOKEN_1=
# CLAUDE_TOKEN_2=

# ── Scout — сорсинг кандидатів ─────────────────────
APIFY_TOKEN=
BRAVE_API_KEY=
CANDIDATE_SHEET_ID=
RESEARCH_SHEET_ID=

# ── Google Workspace ────────────────────────────────
# Service Account JSON (одним рядком)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# ── Sirius — контент ────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=
SIRIUS_DRIVE_FOLDER_ID=

# ── Голос ───────────────────────────────────────────
GROQ_API_KEY=

# ── Налаштування ────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TURNS=20
SCOUT_CRON=0 9 * * 1
IG_SCOUT_CRON=0 6 * * 1
SCOUT_RUN_ON_START=false
