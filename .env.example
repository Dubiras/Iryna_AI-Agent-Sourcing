# ═══════════════════════════════════════════════════
# LumysAgent Orchestrator — Environment Variables
# cp .env.example .env  і заповни
# ═══════════════════════════════════════════════════

# ── Обов'язкові ─────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# Telegram (один токен для оркестратора)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DIGEST_CHAT_ID=

# Claude OAuth токени (claude.ai → Settings → API)
CLAUDE_CODE_OAUTH_TOKEN=
# Додаткові токени для ротації при rate limit:
# CLAUDE_TOKEN_1=
# CLAUDE_TOKEN_2=

# ── Scout — сорсинг кандидатів ─────────────────────
APIFY_TOKEN=
BRAVE_API_KEY=

# Scout's own Sheets/Calendar/Mail — Microsoft Graph (Excel Online / Outlook), not Google.
# Azure AD app registration → Application (client) ID / Directory (tenant) ID:
MS_CLIENT_ID=
MS_TENANT_ID=
# OneDrive paths to the Excel workbooks (created once, e.g. via OneDrive web UI):
CANDIDATE_WORKBOOK_PATH=/LumysAgent/Candidates.xlsx
RESEARCH_WORKBOOK_PATH=/LumysAgent/Research.xlsx
# One-time login: run `python ms_auth_setup.py` (works directly on the server, no browser needed there)

# ── Google Workspace (mcp-hr / mcp-sirius / mcp-argus — unaffected by the Scout migration) ──
# Service Account JSON (одним рядком)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=
RESEARCH_SHEET_ID=

# ── Sirius — контент ────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=
SIRIUS_DRIVE_FOLDER_ID=

# ── Голос ───────────────────────────────────────────
GROQ_API_KEY=

# ── Налаштування ────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TURNS=20
SCOUT_CRON=0 9 * * 1
IG_SCOUT_CRON=0 6 * * 1
SCOUT_RUN_ON_START=false
